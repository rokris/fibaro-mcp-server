# Fibaro Home Center Configuration
# Copy this file to .env and fill in your details

# Fibaro Home Center IP address or hostname
FIBARO_URL=http://192.168.1.100

# Fibaro Home Center credentials
FIBARO_USERNAME=admin
FIBARO_PASSWORD=your_password_here

# Optional: Use HTTPS (set to true if your HC2 uses HTTPS)
# FIBARO_USE_HTTPS=false
