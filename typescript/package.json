  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rokris/fibaro-mcp-server.git"
  },
  "homepage": "https://github.com/rokris/fibaro-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/rokris/fibaro-mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
