{
  "name": "fibaro-mcp-server",
  "version": "1.0.15",
  "description": "Model Context Protocol server for Fibaro Home Center 2 integration with AI assistants",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fibaro-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
